{
  "name": "mortal-doctrine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.ts pnpm --parallel --filter \"./apps/*\" dev",
    "dev:game": "node scripts/dev.ts pnpm --filter @mortal-doctrine/game dev",
    "dev:studio": "node scripts/dev.ts pnpm --filter @mortal-doctrine/studio dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "bench": "vitest bench --run --reporter=verbose",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test && pnpm build",
    "check:all": "pnpm check && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
